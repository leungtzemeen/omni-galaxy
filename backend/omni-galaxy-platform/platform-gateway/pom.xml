<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.omnigalaxy</groupId>
        <artifactId>omni-galaxy-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>platform-gateway</artifactId>
    <name>platform-gateway</name>
    <description>OmniGalaxy 微服务统一网关入口进程</description>
    <dependencies>
        <!-- 引入网关专用的响应式微服务包（无版本号，服从仲裁） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- 响应式 Redis：JwtVerificationFilter 黑名单/熔断时间戳校验依赖，严禁使用阻塞版 StringRedisTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- 复用 JwtClaimsResolver：与 platform-auth-biz 共用同一套 JWT 解析与签名校验逻辑 -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Nacos 服务注册与发现（版本由根 POM 的 spring-cloud-alibaba-dependencies 仲裁） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 路由 uri 使用 lb:// 协议时，由 LoadBalancer 结合 Nacos 解析具体实例，缺失会导致路由 503 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
