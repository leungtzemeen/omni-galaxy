<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.omnigalaxy</groupId>
        <artifactId>platform-auth</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>platform-auth-biz</artifactId>
    <name>platform-auth-biz</name>
    <description>OmniGalaxy 认证中心核心业务运行进程</description>
    <dependencies>
        <!-- 引入自己对应的 API 契约包 -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>platform-auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 引入底座专用的三大核心工具包 -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Web 容器：需要运行 web 死守"单模块独立可跑"的健壮性原则 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Redis：OTP 存储与冷却管控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- OTP 核心能力（验证码生成、Redis 管控、冷却限制） -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>common-captcha</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 通用安全拦截器（白名单配置） -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 用户中心 Feign 契约（Phase 2 实际调用） -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>platform-user-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Cloud OpenFeign：Feign 客户端运行时（动态代理 + LoadBalancer） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- MyBatis-Plus 通用组件（元数据自动填充、分页） -->
        <dependency>
            <groupId>com.omnigalaxy</groupId>
            <artifactId>common-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MySQL 驱动：独立进程必须显式声明，防御重构原则 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- Knife4j：接口文档（OpenAPI 3） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <!-- JWT 生成三件套（api 编译期，impl/jackson 运行期） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 单元测试：JUnit5 + Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
