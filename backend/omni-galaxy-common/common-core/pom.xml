<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.omnigalaxy</groupId>
        <artifactId>omni-galaxy-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath> <!-- 精确指向 common 的二级父POM -->
    </parent>

    <artifactId>common-core</artifactId>

    <name>common-core</name>
    <description>OmniGalaxy 全局核心工具、统一响应、全局异常处理组件</description>

    <dependencies>
        <!-- 引入 Spring Web 基础包：为了让统一返回值能用到 HTTP 相关的注解、状态码和 Jackson 序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 意思是只在编译期借用一下，不参与打包流转 -->
            <scope>provided</scope>
            <!-- 严格遵守红线规约：严禁编写 version 标签，无条件从顶级 POM 继承 -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <!-- 严格遵守红线：不写version，版本由顶级 POM 的 3.3.12 仲裁 -->
        </dependency>

    </dependencies>
</project>
